# Install as /etc/sudoers.d/hw1-power-helper, root:root mode 0440.
# Only members of the dedicated hw1-power group may invoke the finite helper.
# The helper independently validates every argument and never invokes a shell.

Cmnd_Alias HW1_POWER = \
    /usr/local/libexec/hw1-power-helper status, \
    /usr/local/libexec/hw1-power-helper profile eco, \
    /usr/local/libexec/hw1-power-helper profile balanced, \
    /usr/local/libexec/hw1-power-helper profile performance, \
    /usr/local/libexec/hw1-power-helper profile auto, \
    /usr/local/libexec/hw1-power-helper reboot, \
    /usr/local/libexec/hw1-power-helper halt, \
    /usr/local/libexec/hw1-power-helper poweroff, \
    /usr/local/libexec/hw1-power-helper suspend, \
    /usr/local/libexec/hw1-power-helper ^sleep_for ([1-9]|[1-9][0-9]|[1-9][0-9][0-9]|1[0-3][0-9][0-9]|14[0-3][0-9]|1440)$

%hw1-power ALL=(root) NOPASSWD: HW1_POWER
